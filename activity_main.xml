<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teal_dark"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BCS ফ্লিপ স্টাডি v2"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ট্র্যাকিং বন্ধ"
            android:textColor="#CCFBF1"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: TIMER -->
        <ScrollView
            android:id="@+id/tabTimer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <Switch
                        android:id="@+id/swFlipService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ফ্লিপ ট্র্যাকিং চালু (ব্যাটারি-সাশ্রয়ী)"
                        android:textColor="@color/text_main"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/swOnlineStudy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="অনলাইনে পড়ছি (স্ক্রিন সোজা থাকলেও পড়া)"
                        android:textColor="@color/teal_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTimerClock"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_circle_timer"
                    android:gravity="center"
                    android:text="৪৫:০০"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPreset45"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="৪৫ মি."
                        android:backgroundTint="@color/teal_primary"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnPreset25"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="২৫ মি."
                        android:backgroundTint="@color/amber_accent"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnResetTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="রিসেট"
                        android:backgroundTint="@color/text_muted"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <EditText
                        android:id="@+id/etSubject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="বিষয় ও টপিক (যেমন: বাংলা ব্যাকরণ)"
                        android:textColor="@color/text_main"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/chkWordTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="আজকের ওয়ার্ড টার্গেট পূরণ হয়েছে"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAddWaste"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/coral_waste"
                        android:text="অপচয় সময় ও কারণ লগ করো (+১৫ মি.)"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTodayStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: MONTHLY / YEARLY REPORT -->
        <ScrollView
            android:id="@+id/tabReport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPrevPeriod"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="◀"
                        android:backgroundTint="@color/teal_dark"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvPeriodTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnNextPeriod"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:backgroundTint="@color/teal_dark"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnToggleYearly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="বার্ষিক দেখো"
                        android:textSize="11sp"
                        android:backgroundTint="@color/amber_accent"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReportOfflineBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/amber_soft"
                    android:padding="6dp"
                    android:text="অফলাইন / লোকাল ডেটা দেখানো হচ্ছে"
                    android:textColor="@color/amber_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvReportSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:textColor="@color/teal_dark"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textStyle="bold" />

                <com.bcs.flipstudy.WeeklyBarChartView
                    android:id="@+id/reportBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card" />

                <TextView
                    android:id="@+id/tvReportBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: WEEKLY DASHBOARD -->
        <ScrollView
            android:id="@+id/tabWeekly"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="শেষ ৭ দিন (সবুজ=পড়া, লাল=অপচয়, নীল=ঘুম/অন্যান্য)"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.bcs.flipstudy.WeeklyBarChartView
                    android:id="@+id/weeklyChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWeeklyStudy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="@color/teal_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeeklyWaste"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="@color/coral_waste"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeeklySleep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="@color/indigo_sleep"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvSyncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="এখনো সিঙ্ক হয়নি"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnSyncNow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/teal_dark"
                        android:text="এখনই Google Drive-এ সিঙ্ক করো"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 4: SETTINGS -->
        <ScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Apps Script Web App URL (/exec)"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGasUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="https://script.google.com/macros/s/.../exec"
                    android:inputType="textUri"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="গোপন সিঙ্ক কী (Apps Script Properties-এর SYNC_KEY)"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSyncKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="যেমন: bcs2026secret (খালি রাখলে কী ছাড়াই চলবে)"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/swAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="সেশন শেষে অ্যালার্ম ও ভাইব্রেশন"
                    android:textColor="@color/text_main" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/teal_primary"
                    android:text="সেটিংস সেভ করো"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/card_bg"
        android:elevation="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navTimer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⏱️ টাইমার"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navReport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📅 রিপোর্ট"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navWeekly"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📊 সাপ্তাহিক"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙️ সেটিংস"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
